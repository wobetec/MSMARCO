<services version="1.0">
  <!-- Container (API + Search) -->
  <container id="msmarco-container" version="1.0">
    <!-- Hugging Face embedding model component -->
    <component id="hf-embedder" type="hugging-face-embedder">
      <transformer-model path="models/bert_base_uncased/model.onnx"/>
      <tokenizer-model path="models/bert_base_uncased/tokenizer.json"/>
      <max-tokens>512</max-tokens>
      <normalize>true</normalize>
      <pooling-strategy>mean</pooling-strategy>
    </component>

    <search/>
    <document-api/>
    <nodes count="1"/>
  </container>

  <!-- Content Cluster (armazenamento e indexação) -->
  <content id="msmarco" version="1.0">
    <redundancy>1</redundancy>
    <documents>
      <document type="msmarco" mode="index"/>
    </documents>
    <nodes count="1"/>
  </content>
</services>
